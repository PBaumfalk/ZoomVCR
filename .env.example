# Copy to .env and set strong random secrets. Never commit .env.
ZOOMVCR_ADMIN_PASSWORD=CHANGE_TO_A_LONG_UNIQUE_PASSWORD
ZOOMVCR_SECRET_KEY=CHANGE_TO_64_RANDOM_HEX_CHARACTERS
ZOOMVCR_API_TOKEN=CHANGE_TO_A_SEPARATE_LONG_RANDOM_TOKEN
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_DB_PASSWORD
ZOOMVCR_DATABASE_URL=postgresql+psycopg://zoomvcr:${POSTGRES_PASSWORD}@postgres:5432/zoomvcr
ZOOMVCR_REDIS_URL=redis://redis:6379/0
ZOOMVCR_STORAGE_ROOT=/data/recordings
# Adresse, unter der ZoomVCR im Browser geöffnet wird (exakt so, ohne / am Ende).
# Server: https://vcr.example.com  ·  Probelauf auf diesem Rechner: http://localhost:8080
ZOOMVCR_PUBLIC_ORIGIN=https://record.example.com
# Site für den mitgelieferten Caddy: Domain = automatisches HTTPS (öffentliches DNS nötig), :80 = nur HTTP
ZOOMVCR_SITE=record.example.com
# Ports des mitgelieferten Caddy auf dem Host
ZOOMVCR_HTTP_PORT=80
ZOOMVCR_HTTPS_PORT=443
ZOOMVCR_TIMEZONE=Europe/Berlin
# KI-Anbindung (Transkription + Auswertung) wird normalerweise in der Oberfläche eingestellt:
# Verwaltung → KI und Benachrichtigung (API-Key verschlüsselt in der Datenbank). Die Werte hier sind nur Rückfall.
# Transkription: openai (über den KI-Dienst) | local (Whisper, nur mit ZOOMVCR_LOCAL_ASR=true) | off
ZOOMVCR_ASR_PROVIDER=openai
# true = Backend-Image mit lokalem Whisper bauen (größer, langsamer, kein Ton verlässt den Server)
ZOOMVCR_LOCAL_ASR=false
ZOOMVCR_ASR_MODEL=small
ZOOMVCR_OCR_LANG=deu+eng
ZOOMVCR_AI_URL=
ZOOMVCR_AI_MODEL=
ZOOMVCR_AI_API_KEY=
# Enable desktop mode after first Zoom login and operator permission setup.
ZOOMVCR_ENABLE_DESKTOP=false
# Enable Zoom desktop only after operator login via VNC and permission setup.
ZOOMVCR_VNC_PASSWORD=CHANGE_ME_USE_STRONG_RANDOM_VALUE
ZOOMVCR_DESKTOP_AGENT_URL=http://desktop:8765
ZOOMVCR_JOIN_TIMEOUT_SECONDS=180
ZOOMVCR_JOIN_GRACE_SECONDS=12
# 0 = never infer admission automatically. Optional experimental fallback (seconds):
ZOOMVCR_ASSUME_JOINED_AFTER_SECONDS=0
# true = Aufnahme startet erst, wenn der Zoom-Name per OCR oder vom Betreiber bestätigt ist
ZOOMVCR_REQUIRE_NAME_CONFIRMATION=true
ZOOMVCR_DESKTOP_WIDTH=1920
ZOOMVCR_DESKTOP_HEIGHT=1080
ZOOMVCR_DESKTOP_FPS=15
# Benutzerverwaltung: beim ERSTEN Start wird genau ein Admin aus diesem Passwort erstellt.
# Nach erfolgreicher Anlage darf ZOOMVCR_ADMIN_PASSWORD aus .env entfernt werden.
ZOOMVCR_BOOTSTRAP_ADMIN_USERNAME=admin
# Optional: zentrale Anmeldung (SSO) über OpenID Connect (authentik, Keycloak …). Ohne diese drei Werte bleibt SSO deaktiviert.
# Discovery: https://authentik.example.com/application/o/zoomvcr/.well-known/openid-configuration
ZOOMVCR_OIDC_DISCOVERY_URL=
ZOOMVCR_OIDC_CLIENT_ID=
ZOOMVCR_OIDC_CLIENT_SECRET=
